# LLM fallback order: Cohere -> Groq.
# Add both keys for automatic failover.
COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Required only for the Telegram bot
TELEGRAM_BOT_TOKEN=
# Random string you invent. Must match the secret_token used in setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Public launch information. Leave blank until confirmed.
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_SWAP_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
